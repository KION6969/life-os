{
  "version": 2,
  "builds": [{ "src": "life-os/**", "use": "@vercel/static" }],
  "routes": [
    { "src": "/(.*)", "dest": "/life-os/$1" }
  ],
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/(.*)", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }] }
  ]
}
